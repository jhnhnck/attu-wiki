{
	frankenphp {
		php_ini {
			upload_max_filesize 100M
			post_max_size 100M
		}
		max_wait_time 300s
	}

	log {
		format json
	}

	servers :8080 {
		protocols h1 h2c
		trusted_proxies static private_ranges
	}

	metrics
}

(max-body-100mb) {
	request_body {
		max_size 100MB
	}
}

(root) {
	root {$APP_HOME}/mediawiki
}

(logging) {
	log {
		format json
	}
}

:8080 {
	import max-body-100mb
	import root
	import logging

	encode zstd br gzip

	@denied_files path \
 */.ht* \
 */.git* \
 /cache* \
 */.* \
 /languages* \
 /maintenance* \
 /serialized* \
 /mw-config* \
 /images/deleted/* \
 /images/temp/*

	handle @denied_files {
		respond 403
	}

	# trees route only included when /etc/frankenphp/Caddyfile.trees exists
	# (dev only; prod build skips the COPY). glob no-ops on no match.
	import /etc/frankenphp/Caddyfile.trees*

	# TODO: deny ip block list from cloudflare

	# never admit to using php -jhn
	# this might redirect to a 404 in some cases but who cares
	@index_php path_regexp index_php ^/index\.php(.*)$
	redir @index_php /wiki{re.index_php.1} 301

	# based on statistical analysis on wiki log files
	@php_paths path /wiki/* /wiki /load.php /api.php /rest.php*

	handle @php_paths {
		@try_files file {path}.php /index.php =401 {
			split_path .php
		}

		php_server @try_files
	}

	# all others shouldn't be called directly
	@php_files path *.php
	respond @php_files 403

	@ext_paths path /skins/* /extensions/*

	handle @ext_paths {
		header Cache-Control "public, max-age=604800"
		file_server
	}

	rewrite /favicon.ico /resources/assets/favicon.ico
	@img_paths path /images/* /resources/assets/

	handle @img_paths {
		header Cache-Control "public, no-transform"
		file_server
	}

	file_server

	handle_errors 404 {
		redir * /wiki{uri} 301
	}
}
