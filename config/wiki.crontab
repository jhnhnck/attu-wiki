# Example of job definition:
# .---------------- minute (0 - 59)
# |  .------------- hour (0 - 23)
# |  |  .---------- day of month (1 - 31)
# |  |  |  .------- month (1 - 12) OR jan,feb,mar,apr ...
# |  |  |  |  .---- day of week (0 - 6) (Sunday=0 or 7) OR sun,mon,tue,wed,thu,fri,sat
# |  |  |  |  |
# *  *  *  *  * command to be executed

# Tasks
*/15 * * * *    zsh $APP_HOME/scripts/attu_tasks.zsh "task:error-rate-monitor"

# Backups
0 18 * * *      zsh $APP_HOME/scripts/attu_tasks.zsh "backup:database"
0 18 */3 * *    zsh $APP_HOME/scripts/attu_tasks.zsh "backup:images"

# Chores
30 0 * * *      zsh $APP_HOME/scripts/attu_tasks.zsh "chore:clean-upload-stash"
0 20 1 * *      zsh $APP_HOME/scripts/attu_tasks.zsh "chore:bundle-backups"
0 20 */3 * *    zsh $APP_HOME/scripts/attu_tasks.zsh "chore:spam-list-refresh"
0 20 */7 * *    zsh $APP_HOME/scripts/attu_tasks.zsh "chore:templates-refresh"
0 20 * * *      zsh $APP_HOME/scripts/attu_tasks.zsh "chore:regenerate-sitemap"
